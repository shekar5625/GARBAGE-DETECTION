# Camera settings for main.py. Copy to Backend/.env (gitignored) and fill in.
# Real environment variables override anything set here.
RTSP_USER=admin
RTSP_PASS=
RTSP_IP=169.254.5.71

# Dashboard upload. CAMERA_AREA is the area name in the dashboard: log in with
# a username equal to it to see only this camera, or as 'admin' to see all.
API_URL=http://127.0.0.1:5000
CAMERA_AREA=area1
